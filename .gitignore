# Your own ripped audio and separated stems — ~860 MB of commercial recordings.
# These are yours, not the project's, and must never be committed or published.
rips/**
stems/**
!rips/.gitkeep
!stems/.gitkeep

# macOS
.DS_Store

# Local Claude Code settings
.claude/settings.local.json

# Personal Codex command approvals
.codex/rules/default.rules

# Superpowers brainstorm scratch (visual companion mockups)
.superpowers/

# npm
node_modules/

# Vite build output — CI builds it fresh, never committed
dist/

# Demo list is regenerated before dev/build; commit only the source demos.
demos/index.html

# Superpowers git worktrees (isolated implementation workspaces)
.worktrees/

# testing data that should not be upload
examples/

# Source audio for the fixed-song page. The lossless zip is 116 MB (over GitHub's 100 MB
# per-file limit on its own), and the repacked one belongs in the R2 bucket puma-stem.js
# points at, not in the repo — same rule as rips/ and stems/.
puma_song/

# Vitest browser-mode failure screenshots/attachments — regenerated per run, never committed
.vitest-attachments/
tests/__screenshots__/
